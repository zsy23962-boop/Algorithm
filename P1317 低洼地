#include <stdio.h>

int main() {
    int n, a[10005];
    int count = 0;
    int down = 0;

    scanf("%d", &n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    for (int i = 1; i < n; i++) {
        if (a[i] < a[i - 1]) {
            down = 1;
        }
        else if (a[i] > a[i - 1] && down == 1) {
            count++;
            down = 0;
        }
    }
    printf("%d\n", count);
    return 0;
}
