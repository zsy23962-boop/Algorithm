#include <stdio.h>

int main()
{
    int a, b, c, d;
    int start, end;
    int time;
    int e, f;

    scanf("%d %d %d %d", &a, &b, &c, &d);

    start = a * 60 + b;
    end = c * 60 + d;

    time = end - start;

    e = time / 60;
    f = time % 60;

    printf("%d %d\n", e, f);

    return 0;
}
