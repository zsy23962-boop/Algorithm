#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int a[10005], b[10005];
    int g[10005], k[10005];
    for (int i = 1; i <= n; i++) {
        scanf("%d %d %d %d",
              &a[i], &b[i], &g[i], &k[i]);
    }
    int x, y;
    scanf("%d %d", &x, &y);
    int ans = -1;
    for (int i = 1; i <= n; i++) {
        if (x >= a[i] && x <= a[i] + g[i] &&
            y >= b[i] && y <= b[i] + k[i]) {
            ans = i;
        }
    }
    printf("%d\n", ans);
    return 0;
}
