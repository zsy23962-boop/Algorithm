#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    long long ans = 0;

    for (int i = 0; i < n; i++) {
        double a;
        int t;
        scanf("%lf %d", &a, &t);

        for (int j = 1; j <= t; j++) {
            long long k = (long long)(a * j);
            ans ^= k;
        }
    }
    printf("%lld\n", ans);

    return 0;
}
