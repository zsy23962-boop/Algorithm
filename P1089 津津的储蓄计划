#include <stdio.h>

int main(){
    int money = 0;
    int save = 0;
    int budget;

    for(int i = 1; i <= 12; i++)
    {
        scanf("%d",&budget);
        money += 300;

        if(money < budget){
            printf("-%d", i);
            return 0;
        }
        money -= budget;
        
        if(money >= 100)
        {
            save += money / 100 * 100;
            money %= 100;
        }
    }
    printf("%d", save + save / 5 + money);

    return 0;
}
